{
  "name": "@lapxo/topos-doc",
  "version": "0.1.3",
  "private": true,
  "description": "The pages a place is read through, rendered from its lines and the receipts of its regions: its door, its guide, its reference, its figures and its citation.",
  "type": "module",
  "license": "MIT",
  "author": "Lapxo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapxo/topos-doc.git"
  },
  "keywords": [
    "topos",
    "capsule",
    "pages",
    "render"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "TARGET.bound",
    "receipts.bound"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@lapxo/obligations": "^0.3.5",
    "@lapxo/topos": "0.1.12"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "5.9.3"
  }
}
